{
  "name": "papas-choice-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@papas-choice/web",
    "build": "npm run build --workspace=@papas-choice/web",
    "preview": "npm run preview --workspace=@papas-choice/web",
    "test": "npm run test --workspace=@papas-choice/content && npm run test:ui --workspace=@papas-choice/web",
    "format": "prettier --write apps/web/src apps/web/tests apps/api/index.mjs packages *.json .github"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
